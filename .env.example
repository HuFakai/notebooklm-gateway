# NotebookLM Gateway 环境变量配置文件
# 复制此文件为 .env 并修改以下值

# 网关对外映射端口
GATEWAY_PORT=18388

# 全局管理 Token，用于桌面客户端推送凭证以及网页控制台登录 (强烈建议修改为强随机密码)
GATEWAY_ADMIN_TOKEN=请替换为至少32字节的强随机令牌

# NoteWeb 与 API 同域部署时留空；分离部署时填写逗号分隔的 HTTPS Origin
GATEWAY_CORS_ORIGINS=

# SDK 客户端池与上传限制
GATEWAY_MAX_CLIENTS=20
GATEWAY_CLIENT_IDLE_SECONDS=1800
GATEWAY_KEEPALIVE_SECONDS=600
GATEWAY_MAX_UPLOAD_BYTES=104857600
